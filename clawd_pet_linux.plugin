            ),
            Switch(
                key="wander",
                text="Гуляет сам",
                default=True,
                subtext="Ходит по экрану, прыгает и машет",
                icon="msg_location",
                on_change=lambda v: self._on_cfg_change("wander", v),
            ),
            Switch(
                key="phrases",
                text="Разговаривает",
                default=True,
