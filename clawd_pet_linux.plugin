                text="Клик — ткнуть, двойной клик — прыжок, удержание — погладить "
                     "(води мышью туда-сюда), перетаскивание — перенести, резкий бросок — полёт. "
                     "Правый клик — меню: позвать, погулять, усыпить, скрыть. "
                     "Позиция и память сохраняются между запусками."
            ),
            Divider(text=text),
        ]

    def _reload_cfg(self):
        self._cfg = {
            "show": bool(self.get_setting("show", True)),
            "size": int(self.get_setting("size", 1) or 0),
            "color": int(self.get_setting("color", 0) or 0),
            "topmost": bool(self.get_setting("topmost", True)),
            "home": int(self.get_setting("home", 0 if IS_LINUX else 1) or 0),
            "gravity": bool(self.get_setting("gravity", True)),
            "wander": bool(self.get_setting("wander", True)),
            "phrases": bool(self.get_setting("phrases", True)),
            "sleep": int(self.get_setting("sleep", 1) or 0),
            "react_sent": bool(self.get_setting("react_sent", True)),
            "ai_enabled": bool(self.get_setting("ai_enabled", False)),
            "ai_key": str(self.get_setting("ai_key", "") or "").strip(),
            "ai_provider": int(self.get_setting("ai_provider", 0) or 0),
            "ai_url": str(self.get_setting("ai_url", "") or "").strip(),
            "ai_model": str(self.get_setting("ai_model", "") or "").strip(),
            "ai_chat": int(self.get_setting("ai_chat", 1) or 0),
            "ai_moods": bool(self.get_setting("ai_moods", True)),
            "ai_move": bool(self.get_setting("ai_move", True)),
            "ai2_url": str(self.get_setting("ai2_url", "") or "").strip(),
            "ai2_key": str(self.get_setting("ai2_key", "") or "").strip(),
            "ai2_model": str(self.get_setting("ai2_model", "") or "").strip(),
            "ai_text": bool(self.get_setting("ai_text", False)),
            "ai_persona": str(self.get_setting("ai_persona", "") or "").strip(),
            "ai_fallback": bool(self.get_setting("ai_fallback", True)),
            "brain_enabled": bool(self.get_setting("brain_enabled", True)),
            "brain_name": str(self.get_setting("brain_name", "") or "").strip(),
            "brain_about": str(self.get_setting("brain_about", "") or "").strip(),
            "brain_learn": bool(self.get_setting("brain_learn", True)),
            "brain_share": bool(self.get_setting("brain_share", True)),
        }

    def _on_cfg_change(self, key, value):
        self._cfg[key] = value
        if self._window is None:
            return
        if key == "show":
            self._window.command("show", {"show": bool(value)})
        elif key in ("size", "color", "topmost", "gravity", "home"):
            self._window.command("config")

    def _on_menu_toggle(self, context=None):
        show = not bool(self._cfg.get("show", True))
        self._cfg["show"] = show
        self.set_setting("show", show)
        if self._window is not None:
            self._window.command("show", {"show": show})

    def _on_menu_recenter(self, context=None):
        if not self._cfg.get("show", True):
            self._cfg["show"] = True
            self.set_setting("show", True)
            if self._window is not None:
                self._window.command("show", {"show": True})
        if self._window is not None:
            self._window.command("recenter")

    def _recenter(self):
        self._on_menu_recenter()

    def _sleep_toggle(self):
        if self._window is not None:
            self._window.command("sleep_toggle")

    def _forget_click(self):
        if self._window is not None:
            self._window.command("forget")
            return
        self.forget()
        BulletinHelper.show_info("Clawd всё забыл")

    # ---------- hook ----------

    def on_send_message_hook(self, account, params):
        try:
            if not self._cfg.get("react_sent", True) or self._window is None:
                return HookResult()
            text = getattr(params, "message", None)
            if isinstance(text, str) and text.strip():
                snippet = text[:AI_TEXT_MAX] if self._cfg.get("ai_text", False) else ""
                self._window.command("sent", {"length": len(text), "text": snippet})
        except Exception:
            self.logger.exception("send-message hook failed")
        return HookResult()

    # ---------- brain ----------

    def _brain_path(self):
        try:
            directory = os.path.join(get_plugins_dir(), "clawd_pet_data")
            ensure_dir_exists(directory)
            return os.path.join(directory, BRAIN_FILE)
        except Exception:
            self.logger.exception("cannot resolve brain path")
            return None

    def _brain_init(self):
        try:
            path = self._brain_path()
            brain = ClawdBrain(path)
            brain.load(str(self.get_setting("brain_json", "") or ""))
            if brain.data["created"] <= 0:
                brain.data["created"] = time.time()
            self._brain = brain
            with self._ai_lock:
                self._ai_history = brain.recent_said(AI_HISTORY)
        except Exception:
            self.logger.exception("brain initialization failed")
            self._brain = None

    def _brain_session(self):
        brain = self._brain
        if brain is None or not self._cfg.get("brain_enabled", True):
            return None
        try:
            tg_name = self._tg_first_name()
            if tg_name:
                brain.data["tg_name"] = tg_name
            away = brain.session_start()
            self._brain_dirty()
            return away
        except Exception:
            self.logger.exception("brain session failed")
            return None

    def _tg_first_name(self):
        try:
            from client_utils import get_user_config
            user = get_user_config().getCurrentUser()
            if user is not None:
                name = str(getattr(user, "first_name", "") or "").strip()
                return name[:30]
        except Exception:
            pass
        return ""

    def _user_name(self):
        name = str(self._cfg.get("brain_name") or "").strip()
        if not name and self._brain is not None:
            name = str(self._brain.data.get("tg_name") or "").strip()
        return name[:30] or None

    def _brain_dirty(self):
        if self._brain_save_pending or self._unloaded:
            return
        self._brain_save_pending = True
        run_on_queue(self._brain_flush, delay=BRAIN_SAVE_DELAY)

    def _brain_flush(self):
        self._brain_save_pending = False
        brain = self._brain
        if brain is None or not brain.dirty:
            return
        try:
            if not brain.save():
                self.set_setting("brain_json", brain.dump())
                with brain.lock:
                    brain.dirty = False
        except Exception:
            self.logger.exception("brain save failed")
        if brain.dirty and not self._unloaded:
            self._brain_dirty()

    def _brain_learn(self, remember):
        brain = self._brain
        if brain is None or not self._cfg.get("brain_enabled", True) or not self._cfg.get("brain_learn", True):
            return
        try:
            if brain.add_note(remember):
                self.logger.info("brain learned a new fact: %s", remember)
            self._brain_dirty()
        except Exception:
            self.logger.exception("brain note save failed")

    def _brain_said(self, text):
        brain = self._brain
        if brain is None or not self._cfg.get("brain_enabled", True):
            return
        try:
            brain.add_said(text)
            self._brain_dirty()
        except Exception:
            self.logger.exception("brain phrase save failed")

    def _brain_prompt(self):
        brain = self._brain
        if brain is None or not self._cfg.get("brain_enabled", True) or not self._cfg.get("brain_share", True):
            return ""
        try:
            return brain.prompt_block(self._user_name(), self._cfg.get("brain_about"))
        except Exception:
            self.logger.exception("cannot build AI memory block")
            return ""

    def _brain_static(self, category, ctx):
        brain = self._brain
        if brain is None or not self._cfg.get("brain_enabled", True):
            return None
        try:
            user = self._user_name()
            roll = random.random()
            if category == "hello" and user and roll < 0.7:
                options = [f"Привет, {user}!", f"{user}, это ты!"]
                days = brain.days_together()
                if days >= 3:
                    options.append(f"Мы вместе уже {days} {ru_plural(days, ('день', 'дня', 'дней'))}")
                return random.choice(options)
            if category == "back" and user and roll < 0.7:
                return random.choice([f"{user}, я скучал!", f"С возвращением, {user}!"])
            if category == "back" and ctx.get("away") and roll < 0.6:
                return f"Тебя не было {ctx['away']}. Я тут сторожил"
            if category == "pet":
                count = int(brain.data["stats"].get("pet", 0))
                if count >= 25 and roll < 0.25:
                    return f"Ты гладил меня {count} {ru_plural(count, ('раз', 'раза', 'раз'))}. Ещё!"
        except Exception:
            self.logger.exception("cannot build memory-based phrase")
        return None

    # ---------- phrases ----------

    def _static_phrase(self, category, ctx):
        with self._phrase_lock:
            phrases = PHRASES.get(category, [category])
            name = ctx.get("name") or self._user_name()
            options = [p for p in phrases if p != self._last_phrase] or phrases
            text = random.choice(options)
            if "{name}" in text:
                text = text.replace("{name}", name or "")
            self._last_phrase = text
        return text

    def _away_label(self, away):
        away = max(0.0, float(away or 0.0))
        if away < 3600:
            return f"{int(away // 60)} мин"
        return f"{away / 3600:.1f} ч"

    # ---------- AI ----------

    def _ai_ready(self):
        cfg = self._cfg
        return bool(cfg.get("ai_enabled") and (cfg.get("ai_key") or cfg.get("ai2_url")))

    def _ai_provider_cfg(self, index):
        cfg = self._cfg
        if index == 0:
            return {
                "ai_key": cfg.get("ai_key"),
                "ai_url": cfg.get("ai_url"),
                "ai_model": cfg.get("ai_model"),
                "ai_provider": cfg.get("ai_provider", 0),
                "ai_persona": cfg.get("ai_persona"),
            }
        return {
            "ai_key": cfg.get("ai2_key") or "",
            "ai_url": cfg.get("ai2_url"),
            "ai_model": cfg.get("ai2_model"),
            "ai_provider": 1,
            "ai_persona": cfg.get("ai_persona"),
        }

    def _ai_providers(self, now):
        cfg = self._cfg
        result = []
        if cfg.get("ai_key") and now >= self._ai_bo[0]:
            result.append(0)
        if cfg.get("ai2_url") and now >= self._ai_bo[1]:
            result.append(1)
        return result

    def _ai_schedule(self, category, ctx, force):
        now = time.monotonic()
        idle = category == "idle"
        if idle:
            gap = AI_CHAT_GAPS[clamp(int(self._cfg.get("ai_chat", 1)), 0, len(AI_CHAT_GAPS) - 1)]
            if gap <= 0 or now < self._ai_idle_next:
                return False
        providers = self._ai_providers(now)
        if not providers:
            return False
        with self._ai_lock:
            if self._ai_busy or (not force and now < self._ai_next):
                return False
            self._ai_busy = True
            self._ai_next = now + AI_COOLDOWN
            if idle:
                self._ai_idle_next = now + gap
            self._say_gen += 1
            gen = self._say_gen
            history = list(self._ai_history)
        chain = [(index, self._ai_provider_cfg(index)) for index in providers]
        memory = self._brain_prompt()
        try:
            run_on_queue(
                lambda: self._ai_worker(category, ctx, gen, chain, history, memory))
        except Exception:
            self.logger.exception("cannot schedule AI request")
            with self._ai_lock:
                self._ai_busy = False
            return False
        return True

    def _ai_worker(self, category, ctx, gen, chain, history, memory=""):
        text = mood = action = remember = None
        err = None
        try:
            for index, cfg in chain:
                try:
                    text, mood, action, remember = self._ai_call(cfg, category, ctx, history, memory)
                    if text or action:
                        break
                except AiHttpError as error:
                    self.logger.warning(
                        "AI provider %s returned HTTP %s: %s", index, error.code, error.body[:300])
                    now = time.monotonic()
                    if error.code == 429:
                        self._ai_bo[index] = now + AI_BACKOFF
                        err = "ИИ: лимит запросов, подожду"
                    elif error.code in (400, 401, 403, 404):
                        self._ai_bo[index] = now + AI_BACKOFF * 5
                        err = AI_ERR_TEXT
                    elif error.code >= 500:
                        self._ai_bo[index] = now + 30.0
                except Exception:
                    self.logger.exception("AI provider %s request failed", index)
                    self._ai_bo[index] = time.monotonic() + 20.0
        finally:
            with self._ai_lock:
                self._ai_busy = False

        if self._unloaded:
            return
        if text or action:
            err = None
            if gen != self._say_gen:
                return
            if remember:
                self._brain_learn(remember)
            if text:
                with self._ai_lock:
                    self._ai_history.append(text)
                    del self._ai_history[:-AI_HISTORY]
                self._brain_said(text)
            if self._window is not None:
                self._window.command("ai", {
                    "text": text or "", "mood": mood or "", "action": action or "",
                })
            return
        if err and time.monotonic() >= self._ai_err_next:
            self._ai_err_next = time.monotonic() + AI_ERR_GAP
            if self._window is not None:
                self._window.command("say", {"text": err})
            return
        if self._cfg.get("ai_fallback", True) and self._window is not None:
            fallback = self._static_phrase(category, ctx)
            if fallback:
                self._window.command("say", {"text": fallback})

    def _ai_test(self):
        if self._unloaded:
            return
        self._ai_bo = [0.0, 0.0]
        self._ai_next = 0.0
        self._ai_idle_next = 0.0
        self._ai_err_next = 0.0
        if not self._cfg.get("show", True):
            self._on_menu_toggle()
        if not self._ai_ready():
            BulletinHelper.show_info("Включи ИИ и вставь API-ключ")
            return
        text = self._static_phrase("hello", {})
        if text and self._window is not None:
            self._window.command("say", {"text": text})
        with self._ai_lock:
            self._ai_busy = False
            self._ai_schedule("hello", {}, True)
        BulletinHelper.show_info("Запрос к ИИ отправлен")

    def _ai_call(self, cfg, category, ctx, history, memory=""):
        prompt = self._ai_prompt(category, ctx)
        if memory:
            prompt = memory + "\n\n" + prompt
        if history:
            prompt += "\nТвои последние реплики (не повторяйся): " + " | ".join(history)
        system = AI_SYSTEM
        if cfg.get("ai_persona"):
            system += " Дополнительно к характеру: " + str(cfg["ai_persona"])
        if int(cfg.get("ai_provider") or 0) == 1:
            raw = self._ai_call_openai(cfg, system, prompt)
        else:
            raw = self._ai_call_gemini(cfg, system, prompt)
        return self._parse_ai(raw)

    def _ai_prompt(self, category, ctx):
        situation = SITUATIONS.get(category, str(category))
        lines = [f"Ситуация: {situation}", f"Сейчас {time.strftime('%H:%M')}."]
        for key, label in CTX_LABELS:
            value = ctx.get(key)
            if value is None or value == "":
                continue
            value = " ".join(str(value).split())[:AI_TEXT_MAX]
            lines.append(f"{label}: {value}")
        position = self._position_label()
        if position:
            lines.append(f"Где ты сейчас на экране: {position}")
        return "\n".join(lines)

    def _position_label(self):
        if self._window is None:
            return None
        area = self._window._work_area()
        if area is None:
            return None
        fx = (self._window._x - area.left) / max(1.0, area.right - area.left - self._window._pet_w)
        fy = (self._window._y - area.top) / max(1.0, area.bottom - area.top - self._window._pet_h)
        horizontal = "у левого края" if fx < 0.2 else "у правого края" if fx > 0.8 else "в середине по горизонтали"
        vertical = "вверху" if fy < 0.25 else "внизу" if fy > 0.75 else "посередине по высоте"
        return f"{horizontal}, {vertical}"

    def _ai_call_gemini(self, cfg, system, prompt):
        model = str(cfg.get("ai_model") or AI_GEMINI_MODEL).strip()
        if model.startswith("models/"):
            model = model[len("models/"):]
        url = f"{AI_GEMINI_URL}/models/{model}:generateContent"
        headers = {
            "Content-Type": "application/json",
            "x-goog-api-key": str(cfg["ai_key"]),
            "User-Agent": "Mozilla/5.0 (clawd_pet desktop plugin)",
        }
        body = {
            "systemInstruction": {"parts": [{"text": system}]},
            "contents": [{"role": "user", "parts": [{"text": prompt}]}],
            "generationConfig": {
                "maxOutputTokens": 300,
                "temperature": 1.0,
                "responseMimeType": "application/json",
                "thinkingConfig": {"thinkingLevel": "minimal"},
            },
        }
        try:
            data = self._http_json(url, headers, body)
        except AiHttpError as error:
            if error.code == 400 and "thinking" in error.body.lower():
                body["generationConfig"].pop("thinkingConfig", None)
                data = self._http_json(url, headers, body)
            else:
                raise
        parts = data["candidates"][0]["content"]["parts"]
        return "".join(str(part.get("text", "")) for part in parts if not part.get("thought"))

    def _ai_call_openai(self, cfg, system, prompt):
        base = str(cfg.get("ai_url") or AI_OPENAI_URL).strip().rstrip("/")
        if not base.lower().startswith(("http://", "https://")):
            base = "https://" + base
        url = base if base.endswith("/chat/completions") else base + "/chat/completions"
        headers = {
            "Content-Type": "application/json",
            "User-Agent": "Mozilla/5.0 (clawd_pet desktop plugin)",
        }
        if cfg.get("ai_key"):
            headers["Authorization"] = "Bearer " + str(cfg["ai_key"])
        body = {
            "model": str(cfg.get("ai_model") or AI_OPENAI_MODEL),
            "messages": [
                {"role": "system", "content": system},
                {"role": "user", "content": prompt},
            ],
            "max_tokens": 170,
            "temperature": 0.95,
        }
        timeout = AI_TIMEOUT_LOCAL if url.lower().startswith("http://") else AI_TIMEOUT
        data = self._http_json(url, headers, body, timeout)
        return data["choices"][0]["message"]["content"]

    def _parse_ai(self, raw):
        raw = str(raw or "").strip()
        say = None
        mood = None
        action = None
        remember = None
        match = re.search(r"\{.*\}", raw, re.S)
        if match:
            try:
                obj = json.loads(match.group(0))
                say = str(obj.get("say") or "")
                mood = str(obj.get("mood") or "").strip().lower()
                action = str(obj.get("action") or "").strip().lower()
                remember = str(obj.get("remember") or "").strip()
            except Exception:
                say = None
        if say is None and '"say"' in raw:
            def grab(key):
                found = re.search(r'"' + key + r'"\s*:\s*"([^"]*)"', raw)
                return found.group(1).strip().lower() if found else None

            found = re.search(r'"say"\s*:\s*"([^"]*)"', raw)
            say = found.group(1) if found else ""
            mood = grab("mood")
            action = grab("action")
            found = re.search(r'"remember"\s*:\s*"([^"]*)"', raw)
            remember = found.group(1).strip() if found else None
        if say is None:
            say = "" if raw.lstrip().startswith(("{", "`")) else raw
        if mood not in MOODS:
            mood = None
        if action not in ACTIONS:
            action = None
        return self._clean_ai_text(say), mood, action, (remember or None)

    def _http_json(self, url, headers, body, timeout=AI_TIMEOUT):
        request = urllib.request.Request(
            url,
            data=json.dumps(body).encode("utf-8"),
            headers=headers,
            method="POST",
        )
        try:
            with urllib.request.urlopen(request, timeout=timeout) as response:
                return json.loads(response.read().decode("utf-8"))
        except urllib.error.HTTPError as error:
            try:
                detail = error.read().decode("utf-8", "ignore")
            except Exception:
                detail = ""
            raise AiHttpError(error.code, detail)

    def _clean_ai_text(self, text):
        text = str(text or "").strip()
        if not text:
            return None
        text = text.splitlines()[0].strip()
        text = text.strip("\"'«»“”„ ")
        if len(text) > AI_MAX_CHARS:
            text = text[: AI_MAX_CHARS - 1].rstrip() + "…"
        return text or None
