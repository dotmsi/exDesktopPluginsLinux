IS_WINDOWS = os.name == "nt"
IS_LINUX = os.name == "posix" and os.uname().sysname == "Linux"

MODE_NAMES = (
    "Снежинки", "Сакура", "Матрица", "Дождик", "Осенний листопад",
)
MODE_NAMES_EN = (
    "Snowflakes", "Sakura", "Matrix", "Rain", "Autumn Leaves",
)
PARTICLE_COUNTS = list(range(20, 321, 20))          # 20..300 шаг 20 (индекс 4 = 100)
OPACITY_VALUES = list(range(10, 101, 10))           # 10..100 % (индекс 9 = 100)
SPEED_VALUES = tuple("%.1f" % (0.2 + 0.2 * i) for i in range(15))  # 0.2..3.0 (индекс 8 = 1.0)

SIZE_VALUES = ("0.5", "0.75", "1.0", "1.5", "2.0", "2.5", "3.0", "4.0")      # index 2 = 1.0
SPEED_DEFAULT = 4 if IS_LINUX else 8                  # SPEED_VALUES[4] == 1.0
